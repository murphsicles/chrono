 Year,
 YearDiv100,
 YearMod100,
 IsoYear,
 IsoYearDiv100,
 IsoYearMod100,
 Quarter,
 Month,
 Day,
 WeekFromSun,
 WeekFromMon,
 IsoWeek,
 NumDaysFromSun,
 WeekdayFromMon,
 Ordinal,
 Hour,
 Hour12,
 Minute,
 Second,
 Nanosecond,
 Timestamp,
 Internal(InternalNumeric),
}

