/// A single formatting item. This is used for both formatting and parsing.
#[derive(Clone, PartialEq, Eq, Debug, Hash)]
pub enum Item<a> {
 Literal(&str),
 OwnedLiteral(Box<str>),
 Space(&str),
 OwnedSpace(Box<str>),
