/// Maps the local datetime to other datetime with given conversion function.
fn map_local<Tz: TimeZone, F>(dt: &DateTime<Tz>, f: F) -> Option<DateTime<Tz>> where F: FnMut {
 f(dt.overflowing_naive_local()).and_then(| datetime | dt.timezone().from_local_datetime(&datetime).single()).filter(| dt | dt >= &DateTime::<Utc>::MIN_UTC &&dt <= &DateTime::<Utc>::MAX_UTC)
}

