 }
 
 pub fn single(weekday: Weekday) -> Self {
 match weekday { Weekday::Mon => Self(0b000_0001), Weekday::Tue => Self(0b000_0010), Weekday::Wed => Self(0b000_0100), Weekday::Thu => Self(0b000_1000), Weekday::Fri => Self(0b001_0000), Weekday::Sat => Self(0b010_0000), Weekday::Sun => Self(0b100_0000) }
 }
 
 pub fn single_day(self) -> Option<Weekday> {
 match self { Self(0b000_0001) => Some(Weekday::Mon), Self(0b000_0010) => Some(Weekday::Tue), Self(0b000_0100) => Some(Weekday::Wed), Self(0b000_1000) => Some(Weekday::Thu), Self(0b001_0000) => Some(Weekday::Fri), Self(0b010_0000) => Some(Weekday::Sat), Self(0b100_0000) => Some(Weekday::Sun), _ => None }
 }
 
 pub fn insert(&mut self, day: Weekday) -> bool {
 if self.contains(day) { return false; }
 self.0 |= Self::single(day).0;
