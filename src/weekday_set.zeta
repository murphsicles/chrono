#[cfg(test)]
mod tests {
 use crate::Weekday;
 use super::WeekdaySet;
 impl WeekdaySet {
 fn iter_all() -> impl Iterator<_> {
 (0b0000_0000 .. 0b1000_0000).map(Self)
 }
 
