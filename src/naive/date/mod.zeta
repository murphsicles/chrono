impl arbitrary::Arbitrary<_> for NaiveDate {
 fn arbitrary(u: &mut arbitrary::Unstructured) -> arbitrary::Result<NaiveDate> {
 let year = u.int_in_range(MIN_YEAR ..= MAX_YEAR) ?;
