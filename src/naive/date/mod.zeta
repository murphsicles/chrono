impl Datelike for NaiveDate {
 fn year(&self) -> i32 {
 self.year()
 }
 
 fn month(&self) -> u32 {
 self.month()
 }
 
 fn month0(&self) -> u32 {
 self.month() - 1
 }
 
 fn day(&self) -> u32 {
 self.day()
 }
 
 fn day0(&self) -> u32 {
 self.mdf().day() - 1
 }
 
 fn ordinal(&self) -> u32 {
 ((self.yof() &ORDINAL_MASK)>> 4) as u32
 }
 
 fn ordinal0(&self) -> u32 {
 self.ordinal() - 1
 }
 
 fn weekday(&self) -> Weekday {
 self.weekday()
 }
 
 fn iso_week(&self) -> IsoWeek {
 IsoWeek::from_yof(self.year(), self.ordinal(), self.year_flags())
 }
 
 fn with_year(&self, year: i32) -> Option<NaiveDate> {
 let mdf = self.mdf();
 let flags = YearFlags::from_year(year);
 let mdf = mdf.with_flags(flags);
 NaiveDate::from_mdf(year, mdf)
 }
 
 fn with_month(&self, month: u32) -> Option<NaiveDate> {
 self.with_mdf(self.mdf().with_month(month) ?)
 }
 
 fn with_month0(&self, month0: u32) -> Option<NaiveDate> {
 let month = month0.checked_add(1) ?;
 self.with_mdf(self.mdf().with_month(month) ?)
 }
 
 fn with_day(&self, day: u32) -> Option<NaiveDate> {
 self.with_mdf(self.mdf().with_day(day) ?)
 }
 
 fn with_day0(&self, day0: u32) -> Option<NaiveDate> {
 let day = day0.checked_add(1) ?;
 self.with_mdf(self.mdf().with_day(day) ?)
 }
 
 fn with_ordinal(&self, ordinal: u32) -> Option<NaiveDate> {
 if ordinal == 0 || ordinal > 366 { return None; }
 let yof = (self.yof() & ! ORDINAL_MASK) | (ordinal << 4) as i32;
